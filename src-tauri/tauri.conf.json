{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbital Pro",
  "mainBinaryName": "OrbitalPro",
  "version": "0.94.9",
  "identifier": "com.orbital.pro",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:14321"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbital Pro",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "../target/release/orbital-mcp.exe": "orbital-mcp.exe",
      "../target/release/orbital-proxy.exe": "orbital-proxy.exe"
    },
    "publisher": "Orbital",
    "copyright": "© 2026 Orbital",
    "category": "Productivity",
    "shortDescription": "本机记忆中枢：可审计、可回溯、可撤销",
    "longDescription": "Orbital Pro 是一个本机运行的三进程记忆中枢（GUI + 记忆核心 + 注入代理）。所有数据存在 %LOCALAPPDATA%\\OrbitalPro，支持备份/恢复、崩溃自愈、日志诊断与脱敏导出。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
