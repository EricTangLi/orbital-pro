@import "tailwindcss";

/*
 * 设计 token —— 唯一来源是 docs/03-UIUX设计规格.md §3。
 * 代码里**不许**出现裸色值/裸字号/裸圆角（AGENTS.md 红线 4）。
 */
:root {
  /* 字号 5 档 + 指标数字（docs/03 §3.1） */
  --fs-2xs: 11px;
  --fs-xs: 12px;
  --fs-md: 13px;
  --fs-lg: 16px;
  --fs-xl: 20px;
  --fs-num: 26px;

  /* 字重 3 档（§3.2） */
  --fw-normal: 400;
  --fw-medium: 500;
  --fw-semibold: 600;

  /* 间距（§3.3） */
  --sp-page: 32px;
  --sp-card: 20px;
  --sp-cell: 16px;

  /* 圆角 2 档（§3.4；Fluent 2：控件 4 / 卡片 8） */
  --r-control: 4px;
  --r-card: 8px;

  /* 颜色（§3.5） */
  --bg-canvas: #fbfbfc;
  --bg-surface: #ffffff;
  --bg-sunken: #f4f4f5;
  --border-subtle: #e6e6ea;
  --text-primary: #16161a;
  --text-secondary: #5b5b66;
  --text-tertiary: #8c8c99;
  --accent: #6d4aff;
  --ok: #17863f;
  --warn: #b25f00;

  /* ---- Agent 专属色（借鉴 dsh-context「编队」的多色语言：一个 agent 一个色）----
   * 用途：侧栏状态点、Agent 卡片左边条、最近写入的来源标签。
   * 宁可少用也不要让整页变成调色板——只在"标识身份"的地方出现。 */
  --agent-dsh: #4a5699;
  --agent-hermes: #c45fa0;
  --agent-pi: #6277ba;
  --agent-workbuddy: #f39a2b;
  --agent-dsh-soft: #eef0f8;
  --agent-hermes-soft: #fbeef6;
  --agent-pi-soft: #eef1f8;
  --agent-workbuddy-soft: #fdf3e6;

  /* ---- 氛围层：让背景不再是纯白（Linear 的"层"感）---- */
  --bg-page: radial-gradient(1200px 600px at 15% -10%, #f0edff 0%, transparent 60%),
    radial-gradient(900px 500px at 100% 0%, #eef6ff 0%, transparent 55%), #fbfbfc;
  --card-shadow: 0 1px 2px rgba(22, 22, 26, 0.04), 0 8px 24px -12px rgba(22, 22, 26, 0.08);
  --danger: #c62828;
}

/* 深浅色跟随系统，不做 App 内开关（docs/03 §3.5 / ADR-010） */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-canvas: #111113;
    --bg-surface: #18191b;
    --bg-sunken: #0e0e10;
    --border-subtle: #2a2b2f;
    --text-primary: #f2f2f4;
    --text-secondary: #a8a8b3;
    --text-tertiary: #74747f;
    --accent: #9b85ff;
    --ok: #3ecf6b;
    --warn: #f0a13c;
    --danger: #ff6b6b;

      /* Agent 专属色（深色模式：提亮、降饱和，避免刺眼） */
      --agent-dsh: #8b9be0;
      --agent-hermes: #e08cc0;
      --agent-pi: #93a6e0;
      --agent-workbuddy: #f3b465;
      --agent-dsh-soft: #1c1f2e;
      --agent-hermes-soft: #2b1c26;
      --agent-pi-soft: #1b1f2b;
      --agent-workbuddy-soft: #2b2118;
      --bg-page: radial-gradient(1200px 600px at 15% -10%, #1a1730 0%, transparent 60%),
        radial-gradient(900px 500px at 100% 0%, #12202e 0%, transparent 55%), #111113;
      --card-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px -12px rgba(0, 0, 0, 0.6);
  }
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  background: var(--bg-canvas);
  color: var(--text-primary);
  font-family: "Inter Variable", "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: var(--fs-md);
  font-weight: var(--fw-normal);
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: var(--sp-page);
  display: flex;
  flex-direction: column;
  gap: var(--sp-cell);
  min-height: 100%;
}

.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-card);
  padding: var(--sp-card);
}

.title {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  margin: 0;
}

.subtitle {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
  margin: 0;
}

.num {
  font-size: var(--fs-num);
  font-weight: var(--fw-semibold);
  font-variant-numeric: tabular-nums;
}

.row {
  display: flex;
  gap: var(--sp-cell);
  align-items: center;
}

.badge {
  font-size: var(--fs-2xs);
  border-radius: var(--r-control);
  padding: 2px 8px;
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

.badge-ok {
  color: var(--ok);
  border-color: currentColor;
}

.muted {
  color: var(--text-tertiary);
  font-size: var(--fs-2xs);
}

/* 尊重系统"减少动态效果"（docs/03 §6） */
@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}

/* ===== T-M1-13 三进程状态页（只用 token，不用裸值） ===== */

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-card);
}

.refresh {
  display: flex;
  align-items: center;
  gap: var(--sp-cell);
}

.btn {
  font-size: var(--fs-xs);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-control);
  padding: 6px 12px;
  cursor: pointer;
}

.btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.row-between {
  justify-content: space-between;
  align-items: flex-start;
}

.proc-name {
  font-size: var(--fs-lg);
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
}

.num-sub {
  font-size: var(--fs-md);
  color: var(--text-tertiary);
  font-weight: var(--fw-normal);
}

.kv {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-cell);
  margin-top: var(--sp-cell);
  padding-top: var(--sp-cell);
  border-top: 1px solid var(--border-subtle);
}

.kv-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.kv-k {
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
}

.kv-v {
  font-size: var(--fs-md);
  color: var(--text-primary);
  font-weight: var(--fw-medium);
  /* 长的 source_ref 路径必须能断行，否则会压到隔壁列（T-M2-01 实测重叠） */
  word-break: break-all;
  overflow-wrap: anywhere;
}

/* 详情区的元数据在窄栏里 4 列会挤 —— 改成单列（T-M2-01） */
.detail-pane .kv {
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}

.mono {
  font-family: "JetBrains Mono Variable", ui-monospace, monospace;
}

.err-line {
  margin-top: var(--sp-cell);
  font-size: var(--fs-xs);
  color: var(--danger);
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge-danger {
  background: color-mix(in srgb, var(--danger) 12%, transparent);
  color: var(--danger);
}

.badge-warn {
  background: color-mix(in srgb, var(--warn) 14%, transparent);
  color: var(--warn);
}

.card-warn {
  border-color: color-mix(in srgb, var(--warn) 40%, var(--border-subtle));
}

.card-danger {
  border-color: color-mix(in srgb, var(--danger) 40%, var(--border-subtle));
}

/* ============================================================
 * 记忆总览页（T-M2-01）—— 对齐 docs/03 §4.2 主从双栏
 * 全部用本文件上方 :root 的 token；本段不出现裸色值/裸字号/裸圆角（红线 4）
 * ============================================================ */

.filters {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-card);
}

.input {
  font-size: var(--fs-md);
  color: var(--text-primary);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-control);
  padding: 6px 10px;
  font-family: inherit;
  min-width: 140px;
}

.input:focus {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
  border-color: var(--accent);
}

.filters > .input:first-child {
  flex: 1 1 240px;
}

/* 分层卡：可点击过滤（ADR-031：跨表统计，不是 GROUP BY layer） */
.layers {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-cell);
}

.layer-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-card);
  padding: var(--sp-cell);
}

.layer-card .num {
  font-size: var(--fs-num);
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.layer-active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

/* 主从双栏 */
.master-detail {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 4fr);
  gap: var(--sp-card);
  align-items: start;
}

@media (max-width: 900px) {
  .master-detail {
    grid-template-columns: minmax(0, 1fr);
  }
  .layers {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.list-pane,
.detail-pane {
  display: flex;
  flex-direction: column;
  gap: var(--sp-cell);
  min-height: 320px;
}

.list-head {
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: var(--sp-cell);
}

.rows {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-height: 60vh;
  overflow-y: auto;
}

.mem-row {
  padding: 10px 12px;
  border-radius: var(--r-control);
  cursor: pointer;
  border-left: 2px solid transparent;
}

.mem-row:hover {
  background: var(--bg-hover);
}

.mem-row-active {
  background: var(--accent-soft);
  border-left-color: var(--accent);
}

.mem-row-main {
  display: flex;
  align-items: center;
  gap: 8px;
}

.mem-row-summary {
  font-size: var(--fs-md);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem-row-meta {
  margin-top: 4px;
}

.empty {
  font-size: var(--fs-md);
  color: var(--text-tertiary);
  padding: var(--sp-card) 0;
  line-height: 1.6;
}

.pager {
  display: flex;
  gap: var(--sp-cell);
  justify-content: flex-end;
  border-top: 1px solid var(--border-subtle);
  padding-top: var(--sp-cell);
}

.detail-content {
  font-size: var(--fs-md);
  color: var(--text-primary);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  background: var(--bg-sunken);
  border-radius: var(--r-control);
  padding: var(--sp-cell);
  margin: 0;
}

.detail-note {
  border-top: 1px solid var(--border-subtle);
  padding-top: var(--sp-cell);
  line-height: 1.6;
}

@media (prefers-color-scheme: dark) {
  .layer-active,
  .mem-row-active {
    background: var(--accent-soft);
  }
}

/* ============================================================
 * 侧栏 + 总览页（M2 新版界面）
 * 全部 token，无裸值（红线 4）
 * ============================================================ */

/* 整体：侧栏 + 主区 */
.app {
  display: flex;
  min-height: 100vh;
  background: var(--bg-canvas);
}

.side {
  width: 220px;
  flex: 0 0 220px;
  background: var(--bg-sunken);
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
}

.side-hd {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 14px 14px 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.side-hd .mark {
  width: 26px;
  height: 26px;
  border-radius: var(--r-control);
  flex: none;
  color: var(--accent);
}

.side-hd .nm {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  letter-spacing: -0.015em;
  line-height: 1.2;
}

.side-hd .sub {
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
  line-height: 1.3;
}

.side-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.sect {
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
  font-weight: var(--fw-semibold);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 12px 8px 6px;
}

.item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 7px 8px;
  border: none;
  background: transparent;
  border-radius: var(--r-control);
  font-size: var(--fs-md);
  color: var(--text-secondary);
  font-family: inherit;
  cursor: pointer;
  text-align: left;
}

.item:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
}

.item.active {
  background: var(--bg-surface);
  color: var(--text-primary);
  font-weight: var(--fw-medium);
  box-shadow: 0 0 0 1px var(--border-subtle);
}

.item .tail {
  margin-left: auto;
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

.item .nav-icon {
  width: 16px;
  text-align: center;
  flex: none;
  opacity: 0.75;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex: none;
}

.dot-on {
  background: var(--ok);
}

.dot-off {
  background: var(--border-strong);
}

.side-ft {
  border-top: 1px solid var(--border-subtle);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--fs-xs);
  color: var(--text-secondary);
  cursor: pointer;
}

.side-ft .tail {
  margin-left: auto;
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
}

/* 主区 */
.main {
  flex: 1;
  min-width: 0;
  overflow-y: auto;
}

.content {
  max-width: 1320px;
  padding: var(--sp-page) 24px 40px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--sp-card);
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-card);
}

.page-head h1 {
  font-size: var(--fs-xl);
  font-weight: var(--fw-semibold);
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin: 0 0 2px;
}

.page-head .desc {
  font-size: var(--fs-md);
  color: var(--text-tertiary);
  margin: 0;
}

/* 四个指标 */
.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-cell);
}

@media (max-width: 1080px) {
  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.stat-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-card);
  padding: var(--sp-cell);
  text-align: left;
  font-family: inherit;
  cursor: default;
}

.stat-clickable {
  cursor: pointer;
}

.stat-clickable:hover {
  border-color: var(--accent);
}

.stat-value {
  font-size: var(--fs-num);
  font-weight: var(--fw-semibold);
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
  font-weight: var(--fw-medium);
  margin-top: 2px;
}

.stat-sub {
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
  margin-top: 2px;
}

.stat-ok .stat-value {
  color: var(--ok);
}

.stat-warn .stat-value {
  color: var(--warn);
}

.stat-danger .stat-value {
  color: var(--danger);
}

/* 两栏 */
.two-col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--sp-card);
}

@media (max-width: 1080px) {
  .two-col {
    grid-template-columns: minmax(0, 1fr);
  }
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-cell);
  padding-bottom: var(--sp-cell);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--fs-md);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
}

.card-foot {
  border-top: 1px solid var(--border-subtle);
  padding-top: var(--sp-cell);
  line-height: 1.6;
}

/* 分层条 */
.layer-row {
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--sp-cell);
  padding: 10px 0;
}

.layer-name {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.layer-name b {
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
}

.layer-bar {
  height: 6px;
  border-radius: var(--r-control);
  background: var(--bg-sunken);
  overflow: hidden;
}

.layer-bar i {
  display: block;
  height: 100%;
  border-radius: var(--r-control);
}

.bar-l0 {
  background: var(--info);
}

.bar-l1 {
  background: var(--accent);
}

.layer-val {
  font-size: var(--fs-md);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  text-align: right;
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.muted-row {
  opacity: 0.55;
}

/* Agent 列表 */
.agent-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.agent-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 0;
  border-bottom: 1px solid var(--border-subtle);
  cursor: pointer;
  font-size: var(--fs-md);
}

.agent-row:last-child {
  border-bottom: none;
}

.agent-name {
  color: var(--text-primary);
  font-weight: var(--fw-medium);
  min-width: 92px;
}

.agent-num {
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.agent-last {
  margin-left: auto;
}

/* 最近写入 */
.recent-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.recent-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid var(--border-subtle);
  cursor: pointer;
  font-size: var(--fs-md);
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-agent {
  flex: none;
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
  background: var(--bg-sunken);
  border-radius: var(--r-control);
  padding: 1px 6px;
  min-width: 62px;
  text-align: center;
}

.recent-text {
  flex: 1;
  min-width: 0;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex: none;
}

/* 表格（连接页） */
.tbl {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-md);
}

.tbl th {
  text-align: left;
  font-size: var(--fs-2xs);
  font-weight: var(--fw-semibold);
  color: var(--text-tertiary);
  padding: 8px 10px;
  border-bottom: 1px solid var(--border-subtle);
  letter-spacing: 0.02em;
}

.tbl td {
  padding: 9px 10px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-primary);
}

.tbl tr:last-child td {
  border-bottom: none;
}

.todo-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  font-size: var(--fs-md);
  color: var(--text-primary);
}

.btn-sm {
  padding: 4px 10px;
  font-size: var(--fs-xs);
}

/* ============================================================
 * 精致化层（M2 v2）—— 参考 dsh-context「编队」的多色语言
 *
 * 三条原则：
 * 1. **色彩只用来标识身份**（哪个 agent），不用来做装饰——否则变调色板。
 * 2. 背景有"层"（渐变辉光），但**卡片仍是清晰的白**，保证可读性。
 * 3. 所有值来自 :root token（红线 4）。
 * ============================================================ */

body {
  background: var(--bg-page);
  background-attachment: fixed;
}

.app {
  background: transparent;
}

/* 侧栏：半透明 + 毛玻璃（让背景辉光透上来，接近 Linear 的侧栏质感） */
.side {
  background: color-mix(in srgb, var(--bg-sunken) 82%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* 卡片统一阴影（比原来"只有 border"更有层次） */
.card,
.stat-card {
  box-shadow: var(--card-shadow);
}

/* ---- 指标卡：左边条标识语义（不改变数字颜色，避免花）---- */
.stat-card {
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--border-strong);
}

.stat-ok::before {
  background: var(--ok);
}

.stat-warn::before {
  background: var(--warn);
}

.stat-danger::before {
  background: var(--danger);
}

.stat-clickable:hover {
  box-shadow: var(--card-shadow), 0 0 0 1px var(--accent);
}

/* ---- 侧栏 agent 状态点：用各自专属色（编队语言）---- */
.item .dot.dot-on[data-agent="dsh"],
.agent-row[data-agent="dsh"] .dot.dot-on {
  background: var(--agent-dsh);
}

.item .dot.dot-on[data-agent="hermes"],
.agent-row[data-agent="hermes"] .dot.dot-on {
  background: var(--agent-hermes);
}

.item .dot.dot-on[data-agent="pi"],
.agent-row[data-agent="pi"] .dot.dot-on {
  background: var(--agent-pi);
}

.item .dot.dot-on[data-agent="workbuddy"],
.agent-row[data-agent="workbuddy"] .dot.dot-on {
  background: var(--agent-workbuddy);
}

/* ---- Agent 行：悬停时左边条亮出该 agent 的颜色 ---- */
.agent-row {
  border-left: 2px solid transparent;
  padding-left: 8px;
  margin-left: -8px;
  border-radius: var(--r-control);
}

.agent-row:hover {
  background: var(--bg-hover);
}

.agent-row[data-agent="dsh"]:hover {
  border-left-color: var(--agent-dsh);
}

.agent-row[data-agent="hermes"]:hover {
  border-left-color: var(--agent-hermes);
}

.agent-row[data-agent="pi"]:hover {
  border-left-color: var(--agent-pi);
}

.agent-row[data-agent="workbuddy"]:hover {
  border-left-color: var(--agent-workbuddy);
}

/* ---- 最近写入的来源标签：按 agent 上色（软底 + 同色字）---- */
.recent-agent {
  font-weight: var(--fw-medium);
}

.recent-agent[data-agent="dsh"] {
  background: var(--agent-dsh-soft);
  color: var(--agent-dsh);
}

.recent-agent[data-agent="hermes"] {
  background: var(--agent-hermes-soft);
  color: var(--agent-hermes);
}

.recent-agent[data-agent="pi"] {
  background: var(--agent-pi-soft);
  color: var(--agent-pi);
}

.recent-agent[data-agent="workbuddy"] {
  background: var(--agent-workbuddy-soft);
  color: var(--agent-workbuddy);
}

/* ---- 分层条：加渐变，让它看起来是"数据"而不是"进度条" ---- */
.bar-l0 {
  background: linear-gradient(90deg, var(--info), #7aa2ff);
}

.bar-l1 {
  background: linear-gradient(90deg, var(--accent), #9b8bff);
}

.layer-bar {
  position: relative;
}

/* ---- 记忆列表行：悬停 + 选中都有身份感 ---- */
.mem-row:hover {
  background: var(--bg-hover);
}

.mem-row-active {
  background: var(--accent-soft, var(--bg-sunken));
  box-shadow: inset 2px 0 0 var(--accent);
}

/* ---- 顶部标题：给一句更有质感的重心 ---- */
.page-head h1 {
  letter-spacing: -0.025em;
}

/* ---- 表格：表头更轻，行悬停有反馈 ---- */
.tbl tbody tr:hover {
  background: var(--bg-hover);
}

/* ---- 滚动条（细一点，接近 Linear）---- */
.side-scroll::-webkit-scrollbar,
.main::-webkit-scrollbar,
.rows::-webkit-scrollbar,
.detail-pane::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.side-scroll::-webkit-scrollbar-thumb,
.main::-webkit-scrollbar-thumb,
.rows::-webkit-scrollbar-thumb {
  background: var(--border-default, var(--border-subtle));
  border-radius: var(--r-full, 9999px);
}

.side-scroll::-webkit-scrollbar-track,
.main::-webkit-scrollbar-track,
.rows::-webkit-scrollbar-track {
  background: transparent;
}

/* ============================================================
 * 色彩强化层（M2 v3）—— 让界面"有色彩"但不花
 *
 * 手段：给指标卡加**语义淡底**（不是纯白），数字用主题色；
 *      分层每一层有自己的颜色；侧栏当前项有强调底色。
 * 约束：仍是 token（红线 4），且颜色只承担「语义」不承担「装饰」。
 * ============================================================ */

/* ---- 指标卡：语义淡底 + 主题色数字 ---- */
.stat-ok {
  background: color-mix(in srgb, var(--ok) 7%, var(--bg-surface));
  border-color: color-mix(in srgb, var(--ok) 22%, var(--border-subtle));
}

.stat-ok .stat-value {
  color: var(--ok);
}

.stat-warn {
  background: color-mix(in srgb, var(--warn) 8%, var(--bg-surface));
  border-color: color-mix(in srgb, var(--warn) 24%, var(--border-subtle));
}

.stat-warn .stat-value {
  color: var(--warn);
}

.stat-danger {
  background: color-mix(in srgb, var(--danger) 7%, var(--bg-surface));
  border-color: color-mix(in srgb, var(--danger) 22%, var(--border-subtle));
}

.stat-danger .stat-value {
  color: var(--danger);
}

/* 中性卡：用 accent 淡底，让四张卡都有色彩而不是三彩一白 */
.stat-card:not(.stat-ok):not(.stat-warn):not(.stat-danger) {
  background: color-mix(in srgb, var(--accent) 5%, var(--bg-surface));
  border-color: color-mix(in srgb, var(--accent) 16%, var(--border-subtle));
}

.stat-card:not(.stat-ok):not(.stat-warn):not(.stat-danger) .stat-value {
  color: var(--accent-text, var(--accent));
}

/* ---- 侧栏：当前项用 accent 淡底 + 左侧强调 ---- */
.item.active {
  background: color-mix(in srgb, var(--accent) 10%, var(--bg-surface));
  box-shadow: inset 2px 0 0 var(--accent);
  color: var(--accent-text, var(--accent));
}

/* ---- 分层：每层一个色（L0 蓝 / L1 紫 / L2 青 / L3 灰）---- */
.layer-row[data-layer="l0"] .layer-name b {
  color: var(--info);
}

.layer-row[data-layer="l1"] .layer-name b {
  color: var(--accent);
}

.layer-row[data-layer="l2"] .layer-name b {
  color: var(--ok);
}

.layer-row[data-layer="l3"] .layer-name b {
  color: var(--text-tertiary);
}

/* ---- 卡片标题：左侧小色条（让每个区块有识别度）---- */
.card-head {
  position: relative;
  padding-left: 12px;
}

.card-head::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 14px;
  border-radius: var(--r-control);
  background: var(--accent);
  opacity: 0.7;
}

/* ---- 顶部标题：加一条品牌渐变短标记 ---- */
.page-head h1 {
  display: flex;
  align-items: center;
  gap: 8px;
}

.page-head h1::before {
  content: "";
  width: 4px;
  height: 18px;
  border-radius: var(--r-control);
  background: linear-gradient(180deg, var(--accent), var(--info));
}

/* ---- 记忆列表左侧：按 agent 上色（一眼看出谁写的）---- */
.mem-row[data-agent="dsh"] {
  border-left-color: color-mix(in srgb, var(--agent-dsh) 55%, transparent);
}

.mem-row[data-agent="hermes"] {
  border-left-color: color-mix(in srgb, var(--agent-hermes) 55%, transparent);
}

.mem-row[data-agent="pi"] {
  border-left-color: color-mix(in srgb, var(--agent-pi) 55%, transparent);
}

.mem-row[data-agent="workbuddy"] {
  border-left-color: color-mix(in srgb, var(--agent-workbuddy) 55%, transparent);
}

.mem-row {
  border-left-width: 3px;
}

.mem-row-active {
  box-shadow: inset 2px 0 0 var(--accent);
}

/* ---- 深色模式：淡底用更低混合比，避免发灰 ---- */
@media (prefers-color-scheme: dark) {
  .stat-ok {
    background: color-mix(in srgb, var(--ok) 14%, var(--bg-surface));
  }

  .stat-warn {
    background: color-mix(in srgb, var(--warn) 14%, var(--bg-surface));
  }

  .stat-danger {
    background: color-mix(in srgb, var(--danger) 14%, var(--bg-surface));
  }

  .stat-card:not(.stat-ok):not(.stat-warn):not(.stat-danger) {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-surface));
  }

  .item.active {
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-surface));
  }
}

/* ============================================================
 * 数据可视化层（M2 v4）—— 能用图就不用文字
 *
 * 核心：数量差异用**条形长度**表达（谁多谁更长），颜色沿用 agent 身份色。
 * 全部 token（红线 4）。
 * ============================================================ */

/* ---- 指标卡的微进步条（例如"今日新增 / 总量"）---- */
.stat-progress {
  height: 3px;
  border-radius: var(--r-full, 9999px);
  background: color-mix(in srgb, var(--text-tertiary) 18%, transparent);
  margin: 6px 0 2px;
  overflow: hidden;
}

.stat-progress i {
  display: block;
  height: 100%;
  border-radius: var(--r-full, 9999px);
  background: currentColor;
  opacity: 0.75;
  transition: width 400ms var(--ease-decel, cubic-bezier(0.2, 0.8, 0.2, 1));
}

/* ---- Agent 条形图 ---- */
.abar-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px 0;
}

.abar-row {
  display: grid;
  grid-template-columns: 10px 92px minmax(0, 1fr) 44px 76px;
  align-items: center;
  gap: 10px;
  padding: 7px 8px;
  margin: 0 -8px;
  border: none;
  background: transparent;
  border-radius: var(--r-control);
  font-family: inherit;
  font-size: var(--fs-md);
  cursor: pointer;
  text-align: left;
}

.abar-row:hover {
  background: var(--bg-hover);
}

.abar-name {
  color: var(--text-primary);
  font-weight: var(--fw-medium);
}

.abar-track {
  height: 16px;
  border-radius: var(--r-control);
  background: color-mix(in srgb, var(--text-tertiary) 10%, transparent);
  overflow: hidden;
  position: relative;
}

.abar-fill {
  display: block;
  height: 100%;
  border-radius: var(--r-control);
  position: relative;
  /* 小值也必须可见：1/47 ≈ 2% 会不可见，给 8px 下限 */
  min-width: 8px;
  transition: width 500ms var(--ease-decel, cubic-bezier(0.2, 0.8, 0.2, 1));
}

/* 今日新增：在条上叠一层更深的色（占右侧，表示"最新的那部分"） */
.abar-today {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: var(--r-control);
  opacity: 0.45;
  background: repeating-linear-gradient(
    -45deg,
    rgba(255, 255, 255, 0.85) 0 3px,
    transparent 3px 6px
  );
}

.abar-num {
  text-align: right;
  font-weight: var(--fw-semibold);
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
}

.abar-meta {
  text-align: right;
}

/* agent 身份色：填充条与点 */
.abar-fill[data-agent="dsh"] {
  background: var(--agent-dsh);
}

.abar-fill[data-agent="hermes"] {
  background: var(--agent-hermes);
}

.abar-fill[data-agent="pi"] {
  background: var(--agent-pi);
}

.abar-fill[data-agent="workbuddy"] {
  background: var(--agent-workbuddy);
}

/* 图例 */
.abar-legend {
  display: flex;
  align-items: center;
  gap: 14px;
  padding-top: 8px;
  border-top: 1px solid var(--border-subtle);
}

.abar-legend span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.abar-legend i {
  width: 14px;
  height: 8px;
  border-radius: 2px;
  display: inline-block;
}

.lg-strong {
  background: linear-gradient(90deg, var(--agent-dsh), var(--agent-workbuddy));
}

.lg-soft {
  background: repeating-linear-gradient(
    -45deg,
    rgba(255, 255, 255, 0.9) 0 2px,
    color-mix(in srgb, var(--text-tertiary) 30%, transparent) 2px 4px
  );
}

.abar-note {
  margin-left: auto;
}

/* ---- 最近写入：时间轴样式 ---- */
.timeline {
  list-style: none;
  margin: 0;
  padding: 8px 0 0;
  position: relative;
}

.tl-row {
  display: grid;
  grid-template-columns: 10px 68px minmax(0, 1fr) 72px;
  align-items: center;
  gap: 10px;
  padding: 7px 0 7px 2px;
  cursor: pointer;
  font-size: var(--fs-md);
  position: relative;
}

/* 竖线：从每个点连到下一个点 */
.tl-row::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 50%;
  bottom: -50%;
  width: 1px;
  background: var(--border-subtle);
}

.tl-row:last-child::before {
  display: none;
}

.tl-row:hover {
  background: var(--bg-hover);
  border-radius: var(--r-control);
}

.tl-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  justify-self: center;
  background: var(--text-tertiary);
  box-shadow: 0 0 0 3px var(--bg-surface);
}

.tl-dot[data-agent="dsh"] {
  background: var(--agent-dsh);
}

.tl-dot[data-agent="hermes"] {
  background: var(--agent-hermes);
}

.tl-dot[data-agent="pi"] {
  background: var(--agent-pi);
}

.tl-dot[data-agent="workbuddy"] {
  background: var(--agent-workbuddy);
}

.tl-agent {
  font-size: var(--fs-2xs);
  font-weight: var(--fw-medium);
  border-radius: var(--r-control);
  padding: 1px 6px;
  text-align: center;
  background: var(--bg-sunken);
  color: var(--text-secondary);
}

.tl-agent[data-agent="dsh"] {
  background: var(--agent-dsh-soft);
  color: var(--agent-dsh);
}

.tl-agent[data-agent="hermes"] {
  background: var(--agent-hermes-soft);
  color: var(--agent-hermes);
}

.tl-agent[data-agent="pi"] {
  background: var(--agent-pi-soft);
  color: var(--agent-pi);
}

.tl-agent[data-agent="workbuddy"] {
  background: var(--agent-workbuddy-soft);
  color: var(--agent-workbuddy);
}

.tl-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
}

.tl-time {
  text-align: right;
}

/* ---- 微小动效：进页面时卡片轻微上浮（克制，不做花活）---- */
@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.card,
.stat-card {
  animation: cardIn 260ms var(--ease-decel, cubic-bezier(0.2, 0.8, 0.2, 1)) both;
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .stat-card,
  .abar-fill,
  .stat-progress i {
    animation: none;
    transition: none;
  }
}


/* ---- 连接页：每 agent 一张卡（与总览的条形图同一语言）---- */
.conn-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--sp-cell);
}

@media (max-width: 1180px) {
  .conn-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.conn-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
  overflow: hidden;
}

/* 卡片左边条用 agent 身份色 */
.conn-card[data-agent="dsh"]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--agent-dsh);
}
.conn-card[data-agent="hermes"]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--agent-hermes);
}
.conn-card[data-agent="pi"]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--agent-pi);
}
.conn-card[data-agent="workbuddy"]::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--agent-workbuddy);
}

.conn-off {
  opacity: 0.72;
}

.conn-top {
  display: flex;
  align-items: center;
  gap: 8px;
}

.conn-name {
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
}

.conn-top .badge {
  margin-left: auto;
}

.conn-num {
  font-size: var(--fs-num);
  font-weight: var(--fw-semibold);
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.conn-track {
  margin: 4px 0;
}

.conn-meta {
  margin-top: auto;
}
